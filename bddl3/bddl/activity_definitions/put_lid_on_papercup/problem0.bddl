(define (problem put_lid_on_papercup-0)
    (:domain behavior-1k)
    (:objects
        dixie_cup.n.01_1 - dixie_cup.n.01
        cap.n.02_1 - cap.n.02
        table.n.02_1 - table.n.02
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop dixie_cup.n.01_1 table.n.02_1)
        (ontop cap.n.02_1 table.n.02_1)
        (not (attached cap.n.02_1 dixie_cup.n.01_1))
    )
    (:goal (and
        (attached cap.n.02_1 dixie_cup.n.01_1)
    ))
)
