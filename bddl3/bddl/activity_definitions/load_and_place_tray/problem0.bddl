(define (problem load_and_place_tray-0)
    (:domain behavior-1k)
    (:objects
        tray.n.01_1 - tray.n.01
        plate.n.04_1 - plate.n.04
        place_mat.n.01_1 - place_mat.n.01
        table.n.02_1 - table.n.02
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop tray.n.01_1 table.n.02_1)
        (ontop plate.n.04_1 table.n.02_1)
        (not (ontop plate.n.04_1 tray.n.01_1))
        (not (ontop tray.n.01_1 place_mat.n.01_1))
    )
    (:goal (and
        (ontop plate.n.04_1 tray.n.01_1)
        (ontop tray.n.01_1 place_mat.n.01_1)
    ))
)
