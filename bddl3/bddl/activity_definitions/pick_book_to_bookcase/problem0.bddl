(define (problem pick_book_to_bookcase-0)
    (:domain behavior-1k)
    (:objects
        book.n.02_1 - book.n.02
        table.n.02_1 - table.n.02
        bookcase.n.01_1 - bookcase.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop book.n.02_1 table.n.02_1)
        (not (inside book.n.02_1 bookcase.n.01_1))
    )
    (:goal (and (inside book.n.02_1 bookcase.n.01_1)))
)
