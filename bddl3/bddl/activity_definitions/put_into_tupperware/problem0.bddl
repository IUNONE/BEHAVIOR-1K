(define (problem put_into_tupperware-0)
    (:domain behavior-1k)
    (:objects
        tupperware.n.01_1 - tupperware.n.01
        crescent_roll.n.01_1 - crescent_roll.n.01
        table.n.02_1 - table.n.02
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop tupperware.n.01_1 table.n.02_1)
        (ontop crescent_roll.n.01_1 table.n.02_1)
        (not (inside crescent_roll.n.01_1 tupperware.n.01_1))
    )
    (:goal (and
        (inside crescent_roll.n.01_1 tupperware.n.01_1)
    ))
)
