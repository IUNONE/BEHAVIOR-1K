(define (problem put_object_in_hinged_jar-0)
    (:domain behavior-1k)
    (:objects
        hinged_jar.n.01_1 - hinged_jar.n.01
        bratwurst.n.01_1 - bratwurst.n.01
        table.n.02_1 - table.n.02
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop hinged_jar.n.01_1 table.n.02_1)
        (ontop bratwurst.n.01_1 table.n.02_1)
        (not (open hinged_jar.n.01_1))
        (not (inside bratwurst.n.01_1 hinged_jar.n.01_1))
    )
    (:goal (and
        (inside bratwurst.n.01_1 hinged_jar.n.01_1)
        (not (open hinged_jar.n.01_1))
    ))
)
